package timeentry

import (
    "fmt"
    "time"

    "github.com/sgallaghe1541/epilogue/internal/db"
)

templ SelectList(item SelectOption) {
    <option value={ item.SelectValue() }>{ item.SelectString() }</option>
}

templ DayofWeek(date time.Time) {
    if date.IsZero() {
        <label for="dayofweek">Day:</label>
        <input type="text" id="dayofweek" name="dayofweek" disabled>

    } else {
        <label for="dayofweek">Day:</label>
        <input type="text" id="dayofweek" name="dayofweek" value={ date.Weekday().String() } disabled>
    }
}

templ JobStateCertified(job *db.Job) {
    if job != nil {
        <label for="state">State:</label>
        <input type="text" id="state" name="state" value={ job.State } disabled>
        <label for="certified">Certified:</label>
        <input type="text" id="certified" name="certified" value={ job.Certified } disabled>
    } else {
        <label for="state">State:</label>
        <input type="text" id="state" name="state" disabled>
        <label for="certified">Certified:</label>
        <input type="text" id="certified" name="certified" disabled>

    }
}

templ Phases(phases []string) {
    if phases == nil {
      for i := 1; i < 6; i++ {
        if i == 1 {
          <select _="on change if my value is not empty remove @disabled from next <select/> else send clearPhase to the next <select/> end
            on clearPhase set my value to empty add @disabled to me send clearPhase to the next <select/> end" 
            id={ fmt.Sprintf("phase%d", i) } name={ fmt.Sprintf("phase%d", i) } hx-get="/vp/phaseselect" hx-swap="beforeend" hx-trigger="click once" hx-include="previous #job">
            <option value=""></option>
          </select>
        } else {
          <select _="on change if my value is not empty remove @disabled from next <select/> else send clearPhase to the next <select/> end
            on clearPhase set my value to empty add @disabled to me send clearPhase to the next <select/> end" 
            id={ fmt.Sprintf("phase%d", i) } name={ fmt.Sprintf("phase%d", i) } hx-get="/vp/phaseselect" hx-swap="beforeend" hx-trigger="click once" hx-include="previous #job" disabled>
            <option value=""></option>
          </select>
        }
      }
    } else {
      for i := 1; i < 6; i++ {
        if len(phases) >= i {
          <select _="on change if my value is not empty remove @disabled from next <select/> else send clearPhase to the next <select/> end0
            on clearPhase set my value to empty add @disabled to me send clearPhase to the next <select/> end"  
            id={ fmt.Sprintf("phase%d", i) } name={ fmt.Sprintf("phase%d", i) } hx-get="/vp/phaseselect" hx-swap="beforeend" hx-trigger="click once" hx-include="previous #job">
            <option value={ phases[i-1] }>{ phases[i-1] }</option>
          </select>
        } else {
          <select _="on change if my value is not empty remove @disabled from next <select/> else send clearPhase to the next <select/> end
            on clearPhase set my value to empty add @disabled to me send clearPhase to the next <select/> end" 
            id={ fmt.Sprintf("phase%d", i) } name={ fmt.Sprintf("phase%d", i) } hx-get="/vp/phaseselect" hx-swap="beforeend" hx-trigger="click once" hx-include="previous #job" disabled>
            <option value=""></option>
          </select>
        }
      }
    }
}

templ Employees(employees [][]string) {
  if len(employees) != 0 {
    <input type="hidden" id="employeecount" name="employeecount" value={ fmt.Sprintf("%d",len(employees)) }>
  } else {
    <input type="hidden" id="employeecount" name="employeecount" value="0">
  }
  <button type="button" hx-get="views/addemployeerow" hx-swap="beforebegin" hx-include="#employeecount">Add Employee</button>
}

templ Equipment(equipment [][]string) {
  if len(equipment) != 0 {
    <input type="hidden" id="equipmentcount" name="equipmentcount" value={ fmt.Sprintf("%d",len(equipment)) }>
  } else {
    <input type="hidden" id="equipmentcount" name="equipmentcount" value="0">
  }
  <button type="button" hx-get="views/addequipmentrow" hx-swap="beforebegin" hx-include="#equipmentcount">Add Equipment</button>
}

templ TimeCardForm(header *TimeCardHeaderForm, detail *TimeCardDetailForm) {
    // header.job and job have to be the same otherwise this breaks...
    <form>
      <div id="header">
      <div hx-get="/vp/jobselect" hx-swap="beforeend" hx-target="#job" hx-trigger="load once"></div>
        if !header.WorkDate.IsZero() {
            <label for="workdate">Date:</label>
            <input type="date" id="workdate" name="workdate" value={ header.WorkDate.Format("2006-01-02") } _="on input send dateSelected to dayofweek">
        } else {
            <label for="workdate">Date:</label>
            <input type="date" id="workdate" name="workdate" value="" _="on input send dateSelected to #dayofweek-div">
        }
        <div id="dayofweek-div" name="dayofweek-div" hx-get="/utils/weekday" hx-include="#workdate" hx-trigger="dateSelected">
          @DayofWeek(header.WorkDate)
        </div>

        if header.Job != nil {
            <label for="job">Job:</label>
            <select _="on change if my value is not empty send getInfo to me"
            id="job" name="job" hx-get="/vp/jobinfo" hx-target="#jobinfo" hx-trigger="getInfo">
              <option value={ header.Job.SelectValue() } selected>{ header.Job.SelectString() }</option>
            </select>
        } else {
            <label for="job">Job:</label>
            <select id="job" name="job" hx-get="/vp/jobinfo" hx-target="#jobinfo">
            <option value="" selected></option>
            </select>
        }
        <div id="jobinfo" name="jobinfo">
          @JobStateCertified(header.Job)
        </div>
      </div>

      <div id="phases" hx-get="/vp/clearPhasephases" hx-swap="innerHTML" hx-trigger="jobSelected from:body">
        @Phases(detail.Phases)
      </div>

      <div id="employeedetail">
        @Employees(detail.Employees)
      </div>

      <div id="equipmentdetail">
        @Equipment(detail.Equipment)
      </div>
    </form>
}