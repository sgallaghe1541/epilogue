package components

import (
    "fmt"
    "strings"

    "github.com/sgallaghe1541/epilogue/package/viewpoint"
)


templ JobHoursTable(jobs []viewpoint.JobHoursResult) {
    <table class="table-auto w-full text-sm text-left text-gray-500 dark:text-gray-400">
      <thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400 sticky top-0">
        <tr>
          <th scope="col" class="px-4 py-3">Job</th>
          <th scope="col" class="px-4 py-3">Description</th>
          <th scope="col" class="px-4 py-3">Employee Hours</th>
          <th scope="col" class="px-4 py-3">Equipment Hours</th>
        </tr>
      </thead>
      <tbody>
      for _, job := range jobs {
        <tr class="odd:bg-white even:bg-gray-100 dark:odd:bg-neutral-900 dark:even:bg-neutral-800">
          if job.Job.String != "Total" {
            <td class="px-6 py-4 whitespace-nowrap text-end text-sm font-medium">
              <button type="button" class="gap-x-2 text-sm font-semibold rounded-lg border border-transparent text-blue-600 hover:text-blue-800 disabled:opacity-50 disabled:pointer-events-none dark:text-blue-500 dark:hover:text-blue-400" hx-get="/vp/hoursbyjob/" name="job" value={ job.Job.String } hx-include="#params" hx-trigger="click once" hx-target="closest tr" hx-swap="afterend">{ job.Job.String }</button>
            </td>
          } else {
            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-800 dark:text-neutral-200">{ job.Job.String }</td>
          }
          <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-800 dark:text-neutral-200">{ job.Description.String }</td>
          <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-800 dark:text-neutral-200">{ fmt.Sprintf("%.2f", job.EEHours) }</td>
          <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-800 dark:text-neutral-200">{ fmt.Sprintf("%.2f", job.EQHours.Float64) }</td>
        </tr>
      }
      </tbody>
    </table>
}

templ EmployeeHoursTable(emps []viewpoint.EmployeeHoursResult) {
    <table class="w-full table-auto text-sm text-left text-gray-500 dark:text-gray-400">
      <thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400 sticky top-0">
        <tr>
          <th scope="col" class="px-4 py-3">Employee</th>
          <th scope="col" class="px-4 py-3">Name</th>
          <th scope="col" class="px-4 py-3">Hours</th>
        </tr>
      </thead>
      <tbody class="overflow-y-auto">
        for _, emp := range emps {
            <tr class="odd:bg-white even:bg-gray-100 dark:odd:bg-neutral-900 dark:even:bg-neutral-800">
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-800 dark:text-neutral-200">{ emp.Employee }</td>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-800 dark:text-neutral-200">{ emp.Name }</td>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-800 dark:text-neutral-200">{ fmt.Sprintf("%.2f", emp.Hours) }</td>
            </tr>
        }
      </tbody>
    </table>
}

templ EmployeeHoursRows(job string, emps []viewpoint.EmployeeHoursResult) {
    <tr id={ cssID("j", job) }>
        <td><button _={ cssID("on click remove #j", job)}>X</button></td>
        <td>
            <table>
            for _, emp := range emps {
                <tr>
                    <td>{ emp.Employee }</td>
                    <td>{ emp.Name }</td>
                    <td>{ fmt.Sprintf("%.2f", emp.Hours) }</td>
                </tr>
            }
            </table>
        </td>
    </tr>
}

func cssID(before, id string) string {
    combined := before + id
    return strings.ReplaceAll(combined, ".", "")
}