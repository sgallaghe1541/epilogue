package components

import (
    "fmt"

    "github.com/sgallaghe1541/epilogue/package/viewpoint"
)


templ JobHoursTable(jobs []viewpoint.JobTotalHours) {
    <table>
        <tr>
            <th>Job</th>
            <th>Description</th>
            <th>Hours</th>
        </tr>
        for _, job := range jobs {
            <tr>
                <td>{ job.Job.String }</td>
                <td>{ job.Description.String }</td>
                <td>{ fmt.Sprintf("%.2f", job.Hours) }</td>
            </tr>
        }
    </table>
}

templ EmployeeHoursTable(emps []viewpoint.EmployeeTotalHours) {
    <table>
        <tr>
            <th>Employee</th>
            <th>Name</th>
            <th>Hours</th>
        </tr>
        for _, emp := range emps {
            <tr>
                <td>{ emp.Employee }</td>
                <td>{ emp.Name }</td>
                <td>{ fmt.Sprintf("%.2f", emp.Hours) }</td>
            </tr>
        }
    </table>
}