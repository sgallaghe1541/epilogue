package components

import (
    "github.com/sgallaghe1541/epilogue/internal/viewpoint"
)

templ EpilogueTable(r viewpoint.ViewpointResult) {
    <table class="w-full table-auto text-sm text-left text-gray-500 dark:text-gray-400">
      @headerRow(r.Headers())
      <tbody class="overflow-y-auto">
        for _, record := range r.Data(){
          @dataRow(record)
        }
      </tbody>
    </table>
}

templ headerRow(data []string) {
    <thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400 sticky top-0">
        <tr>
          for _, d := range data {
            <th scope="col" class="px-4 py-3">{ d }</th>
          }
        </tr>
      </thead>
}

templ dataRow(data []string) {
    <tr class="odd:bg-white even:bg-gray-100 dark:odd:bg-neutral-900 dark:even:bg-neutral-800">
      for _, d := range data {
        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-800 dark:text-neutral-200">{ d }</td>
      }
    </tr>
}