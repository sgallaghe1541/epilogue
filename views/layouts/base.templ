package layouts

import (
  "github.com/sgallaghe1541/epilogue/views/components"
)

templ Base(name string) {
    <!DOCTYPE html>
    <html lang="en">
    <head>
      <meta charset="UTF-8"></meta>
      <meta name="viewport" content="width=device-width, height=device-height, initial-scale=1.0"></meta>
      <script src="/static/js/htmx.min.js"></script>
      <script src="https://unpkg.com/hyperscript.org@0.9.12"></script>
      <link href="/static/css/styles.css" rel="stylesheet"/>
    </head>
    <body>
      @Header(name)
      @SideBar()
      @Contents()
      @Footer()
    </body>
    </html>
}

templ Header(name string) {
    <div class="fixed t-0 left-0 flex h-20 w-screen flex-row items-center shadow-sm">
      <a href="/"><img class="flex h-20" src="/static/images/logo.jpg" /></a>
      <div class="flex grow flex-col">
        <div class="flex flex-row-reverse items-center">
          <p>{ name }</p>
          <a href="/logout">Log Out</a>
        </div>
      </div>
    </div>
}

templ SideBar() {
    <div class="fixed top-20 left-0 flex flex-col h-[calc(100vh-theme(space.20))] w-24 p-2 bg-stone-900 shadow-sm z-10">
      @components.SideBarIcon("/reports", "Reports", components.IconSVG([]string{"M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z",}))
      @components.SideBarIcon("/timeentry", "Time Entry",components.IconSVG([]string{"M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z",}))
      @components.SideBarIcon("/tools", "Tools",components.IconSVG([]string{"M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 0 0 4.486-6.336l-3.276 3.277a3.004 3.004 0 0 1-2.25-2.25l3.276-3.276a4.5 4.5 0 0 0-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437 1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008Z",}))
      @components.SideBarIcon("/settings", "Settings",components.IconSVG([]string{"M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 0 1 0 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 0 1 0-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28Z","M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z",}))
      @components.SideBarIcon("/admin", "Admin", components.IconSVG([]string{"M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5",}))
    </div>
}

templ Footer() {
    <div class="fixed left-24 bottom-0 h-8 w-[calc(100vw-theme(space.24))] flex items-center justify-center bg-yellow-300">
      <p class="text-stone-50">Quip</p>
    </div>
}

templ Contents() {
    <div id="contents" class="relative grid top-20 left-24 max-h-[calc(100vh-theme(space.28))] h-[calc(100vh-theme(space.28))] max-w-[calc(100vw-theme(space.24))] w-[calc(100vw-theme(space.24))] overflow-clip">
      { children... }
    </div>
}