package reports

templ ListReports(reports map[string]string) {
    <div class="flex flex-row w-full m-4 p-2 rounded-md bg-stone-100 shadow-sm divide-x-2 divide-stone-300">
      <div class="flex flex-col w-fit pr-4 pl-2">
        <p class="text-3xl font-bold">Reports</p>
        <ul class="list-none">
          <li><p hx-get="jobhours/" hx-target="#report" class="text-blue-900 text-xl font-semibold no-underline hover:cursor-pointer hover:underline transition-all">Job Hours</p></li>
        </ul>
      </div>
      <div id="report" class="flex flex-col grow">
      </div>
    </div>
}

templ Report(title string) {
  <div id="title" class="flex h-20 items-center justify-center bg-stone-300">
    <p class="text-2xl font-bold">{ title }</p>
  </div>
  <div class="flex flex-row divide-x-2 divide-stone-300 grow">
    <div id="params" class="flex flex-col p-2 space-y-2">
      <p class="text-xl font-bold">Parameters</p>
      <button class="bg-yellow-200 text-stone-700 rounded-md hover:bg-stone-700 hover:text-yellow-300 transition-all">Run Report</button>
      <button class="bg-yellow-200 text-stone-700 rounded-md hover:bg-stone-700 hover:text-yellow-300 transition-all">Excel</button>
    </div>
    <div id="data" class="flex">
    </div>
  </div>
}